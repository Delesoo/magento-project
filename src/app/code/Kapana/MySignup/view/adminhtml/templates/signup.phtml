<?php
/** @var $block \Kapana\MySignup\Block\Adminhtml\Signup */

// referencing search form from Block/Adminhtml/Signup.php
$searchName = $block->getRequest()->getParam('search_name');
$direction = $block->getRequest()->getParam('direction');
?>

<form method="get" action="<?php echo $block->getUrl('*/*/*'); ?>">
    <label for="search_name"><?php echo __('Search by Name:'); ?></label>
    <input type="text" id="search_name" name="search_name" value="<?php echo $block->escapeHtml($searchName); ?>"/>
    <button type="submit"><?php echo __('Search'); ?></button>
</form>

<?php if (!$block->isSignupEnabled()): ?>
    <p><?php echo __('The signup form is disabled.'); ?></p>
<?php else: ?>
    <div class="admin__data-grid">
        <h2><?php echo __('Sign Ups'); ?></h2>
        <?php $collection = $block->getSignupCollection(); ?>
        <?php if ($collection->getSize()): ?>
            <table class="data-grid">
                <thead>
                <tr>
                    <th><?php echo __('ID'); ?></th>
                    <th><?php echo __('Name'); ?></th>
                    <th>
                        <?php echo __('Date'); ?>
                        <a href="<?php echo $block->getUrl('*/*/*', ['direction' => 'asc']); ?>">ASC</a>
                        <a href="<?php echo $block->getUrl('*/*/*', ['direction' => 'desc']); ?>">DESC</a>
                    </th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($collection as $item): ?>
                    <tr>
                        <td><?php echo $item->getData('signup_id'); ?></td>
                        <td><?php echo $item->getData('name'); ?></td>
                        <td><?php echo $item->getData('date'); ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php else: ?>
            <p><?php echo __('No sign ups found.'); ?></p>
        <?php endif; ?>
    </div>
<?php endif; ?>
